# 复制为 .env.local 后填入，仅本地开发用；线上走 Cloudflare Pages 环境变量
DASHSCOPE_API_KEY=

# --- 飞书推送（可选，不配则「推送到飞书」按钮明确报错，不影响其余功能）---
# 群设置 → 群机器人 → 添加机器人 → 自定义机器人，创建后拿到的地址
FEISHU_WEBHOOK_URL=
# 只有机器人的「安全设置」勾了「签名校验」时才需要；没勾就留空
FEISHU_WEBHOOK_SECRET=

# --- 飞书双向对话（可选）---
# 这几个变量只有 Pages Function 读得到，vite 的 .env.local 对它们无效，
# 本地要调请用 .dev.vars（见 .dev.vars.example）。这里列出来只是备忘清单。
# 开放平台 → 创建企业自建应用 → 添加「机器人」能力 → 事件订阅 im.message.receive_v1
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 事件订阅页填的加密密钥。强烈建议配：配了才有请求验签，不配只能比对 Verification Token
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
# open_id -> OrbitOS 用户 id。没配到的人问什么都不回答，这是有意的
FEISHU_USER_MAP={"ou_xxxxxxxx":"U-006"}
